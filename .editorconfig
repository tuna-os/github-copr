root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# Patches are byte-exact: trailing whitespace is significant in diff context
# lines, and a missing/added final newline changes what `patch` and `%autosetup`
# see. Never let an editor normalise these.
[*.{patch,diff}]
trim_trailing_whitespace = false
insert_final_newline = false

[*.spec]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.{sh,bash}]
indent_style = space
indent_size = 2

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
